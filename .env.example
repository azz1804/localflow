# Copy this file to .env and fill your API key.
OPENAI_API_KEY=sk-your-key

# Audio transcription.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=fr

# Optional post-processing. Keep disabled for the Wispr-like fast path.
ENABLE_POLISH=false
POLISH_MODEL=gpt-4o-mini

# Hold-to-talk hotkeys. "fn" is attempted first; fallback works better on many Macs.
HOLD_HOTKEY=fn
FALLBACK_HOLD_HOTKEY=option+space

# Toggle recording hotkey.
TOGGLE_HOTKEY=fn+space

# Local data.
HISTORY_RETENTION_DAYS=0
RESTORE_CLIPBOARD_AFTER_PASTE=true
PASTE_RESTORE_DELAY_MS=900
PREFER_BUILT_IN_MIC_FOR_BLUETOOTH=true
